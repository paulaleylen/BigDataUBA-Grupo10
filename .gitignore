# ============================================================================
# Data (IMPORTANTE: NO commitear datos grandes)
# ============================================================================
# Ignorar archivos CSV/Excel grandes específicos (>10MB aprox)
TPFinal/data/processed/features_final_modeling.csv
TPFinal/data/processed/features_step3_returns_volatility.csv
TPFinal/data/processed/features_step4_climate.csv
TPFinal/data/processed/commodities_base_daily.csv
TPFinal/data/processed/features_step2_rolling_stats.csv
TPFinal/data/processed/features_step1_temporal_lags.csv
TP1/datos/usu_individual_T105.dta
TP1/datos/usu_individual_T125.xls
TP1/datos/base_completa_05+25.csv
TP2/datos/base_final_tp2.csv
TP2/datos/datos_finales_corregidos.xlsx
TPFinal/data/external/psd_manual/psd_soybeans_all.csv

# Seguir trackeando JSONs, gitkeeps y archivos pequeños
!TPFinal/data/.gitkeep
!TP1/datos/.gitkeep
!TP2/datos/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/interim/predictors/predictors_registry.json
!data/processed/metadata.json

# ============================================================================
# Models (NO commitear modelos entrenados - son pesados)
# ============================================================================
TPFinal/models/**
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
models/*.joblib

# Excepción: SÍ commitear metadata de modelos
!models/model_registry.json
!models/.gitkeep

# ============================================================================
# Reports / Outputs
# ============================================================================
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.pdf
reports/presentations/*.pdf
reports/presentations/*.pptx

# Excepciones para documentos importantes
!reports/figures/.gitkeep
!reports/presentations/.gitkeep

# TP PDFs deben estar en el repo (son documentos de entrega)
!TP1/*.pdf
!TP2/*.pdf
!TP3/*.pdf

