# ============================================================================
# Data (IMPORTANTE: NO commitear datos crudos ni archivos grandes)
# ============================================================================

# Excluir todos los CSVs grandes en data/ (>50MB)
data/processed/features_final_modeling.csv
data/processed/features_step*.csv
data/processed/features_selected_modeling.csv

# Excluir archivos GDELT y sentiment (muy pesados)
data/external/sentiment/**/*.csv
data/external/sentiment/**/*.parquet
data/external/sentiment/temp_batches_v1/**

# Excluir FUT86_16.txt (160 MB)
FUT86_16.txt

# Excepciones: SÍ commitear estos archivos pequeños/importantes
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/interim/predictors/predictors_registry.json
!data/processed/metadata*.json
!data/processed/selected_features_list.txt

# Permitir CSVs pequeños (<10MB) si existen
!data/processed/*_summary.csv
!data/processed/*_metadata.csv

# ============================================================================
# Models (NO commitear modelos entrenados - son pesados)
# ============================================================================
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
models/*.joblib

# Excepción: SÍ commitear metadata de modelos
!models/model_registry.json
!models/.gitkeep

# ============================================================================
# Reports / Outputs
# ============================================================================
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.pdf
reports/presentations/*.pdf
reports/presentations/*.pptx

# Excepciones para documentos importantes
!reports/figures/.gitkeep
!reports/presentations/.gitkeep

# ============================================================================
# Environment variables
# ============================================================================
.env
.env.local

# SÍ commitear el template
!.env.example

# ============================================================================
# Testing
# ============================================================================
.pytest_cache/
.coverage
htmlcov/
*.cover

# ============================================================================
