# ============================================================================
# API Keys para Super Base de Commodities
# ============================================================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo:  Copy-Item .env.example .env
# 2. Editar .env con tus API keys personales
# 3. NO commitear el archivo .env (está en .gitignore)
#
# ============================================================================

# ----------------------------------------------------------------------------
# NASDAQ DATA LINK (ex-Quandl) - OBLIGATORIO
# ----------------------------------------------------------------------------
# Necesario para: Futuros CBOT (CHRIS) - CME_ZC1, CME_ZS1, CME_ZW1
# 
# CHRIS es FREE DATA - Solo requiere registro gratuito (no tarjeta de crédito)
# 
# Pasos para obtener tu API key:
#   1. Crear cuenta gratuita: https://data.nasdaq.com/sign-up
#   2. Ir a Settings → API Key: https://data.nasdaq.com/account/profile  
#   3. Copiar tu API key (20 caracteres alfanuméricos)
#
# IMPORTANTE: Cada usuario debe usar su propia key personal
#             Keys de ejemplo en internet NO funcionan (error 403)
#
# Límite free tier: 300 llamadas/día (suficiente para este proyecto)
#
NDL_API_KEY=your_nasdaq_data_link_key_here

# ----------------------------------------------------------------------------
# USDA PSD API (api.data.gov) - OPCIONAL PARA COMENZAR
# ----------------------------------------------------------------------------
# Necesario para: Balance oferta-demanda global (Production/Supply/Distribution)
#
# Pasos para obtener:
#   1. Registrarse: https://api.data.gov/signup/
#   2. Confirmar email
#   3. Copiar API key (40 caracteres)
#
USDA_API_KEY=your_api_data_gov_key_here

# ----------------------------------------------------------------------------
# Notas adicionales
# ----------------------------------------------------------------------------
# - World Bank e IMF no requieren API keys (descarga directa)
# - FAOSTAT es opcional (descarga manual desde portal)
